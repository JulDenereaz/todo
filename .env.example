# ── Server ─────────────────────────────────
PORT=3000
AUTH_URL=https://todo.denereaz.net
# Generate: openssl rand -base64 33
AUTH_SECRET=
# trace|debug|info|warn|error|fatal|silent — defaults to "debug" (logs everything:
# every API request, every SQL query, every auth event with raw OIDC claims).
# Turn down to "info" once things are stable if the volume gets annoying.
LOG_LEVEL=debug

# ── Authelia OIDC (see README "Authelia OIDC client setup") ──
AUTH_AUTHELIA_ISSUER=https://auth.denereaz.net
AUTH_AUTHELIA_ID=todo
AUTH_AUTHELIA_SECRET=

# ── Database ───────────────────────────────
# Matches the docker-compose volume mount (./data:/app/data)
DATABASE_PATH=/app/data/todo.db
